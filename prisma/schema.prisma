generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum SongStatus {
  READY
  IN_PROGRESS
  WISH
  SHELVED
}

enum LyricsSource {
  MANUAL
  IMPORTED
}

enum SetSection {
  SOUNDCHECK
  MAIN
  ENCORE
}

enum MemberRole {
  ADMIN
  MEMBER
  VIEWER
}

model Band {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members   BandMember[]
  venues    Venue[]
  musicians Musician[]
  setlists  Setlist[]
  gigs      Gig[]
}

model User {
  id        String   @id @default(uuid(7)) @db.Uuid
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships BandMember[]
}

model BandMember {
  id        String     @id @default(uuid(7)) @db.Uuid
  role      MemberRole @default(MEMBER)
  createdAt DateTime   @default(now())

  userId String @db.Uuid
  bandId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  band   Band   @relation(fields: [bandId], references: [id], onDelete: Cascade)

  @@unique([userId, bandId])
  @@index([bandId])
}

model Song {
  id               String     @id @default(cuid())
  title            String
  artist           String?
  key              String?
  singer           String?
  status           SongStatus @default(WISH)
  keyboardRequired Boolean    @default(false)
  durationSeconds  Int?
  bpm              Int?
  lyricsUrl        String?
  chartsUrl        String?
  lyrics           String?
  lyricsSource     LyricsSource?
  lyricsSourceUrl  String?
  lyricsImportedAt DateTime?
  chartFileUrl    String?
  chartFileType    String?
  chartFileName    String?
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  setlistItems SetlistItem[]
  genres       Genre[]
}

model Genre {
  id        String   @id @default(cuid())
  name      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  songs Song[]
}

model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String?
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bandId String @db.Uuid
  band   Band   @relation(fields: [bandId], references: [id])
  gigs   Gig[]

  @@index([bandId])
}

model Musician {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bandId          String        @db.Uuid
  band            Band          @relation(fields: [bandId], references: [id])
  gigMusicians    GigMusician[]
  setlistsCreated Gig[]         @relation("GigSetlistCreator")

  @@unique([bandId, name])
}

model Setlist {
  id        String   @id @default(cuid())
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bandId String        @db.Uuid
  band   Band          @relation(fields: [bandId], references: [id])
  items  SetlistItem[]
  gig    Gig?

  @@index([bandId])
}

model SetlistItem {
  id          String     @id @default(cuid())
  order       Int
  section     SetSection @default(MAIN)
  setNumber   Int        @default(1)
  wasPlayed   Boolean?
  isUnplanned Boolean    @default(false)
  isActive    Boolean    @default(true)
  songId      String
  setlistId   String

  song    Song    @relation(fields: [songId], references: [id])
  setlist Setlist @relation(fields: [setlistId], references: [id])
}

model Gig {
  id               String    @id @default(cuid())
  date             DateTime
  startTime        String?
  endTime          String?
  notes            String?
  amountContracted Decimal?
  amountPaid       Decimal?
  paidAt           DateTime?
  tips             Decimal?
  otherRevenue     Decimal?
  cancelledAt      DateTime?
  cancellationFee  Decimal?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  bandId           String  @db.Uuid
  venueId          String
  setlistId        String  @unique
  setlistCreatorId String?

  band           Band          @relation(fields: [bandId], references: [id])
  venue          Venue         @relation(fields: [venueId], references: [id])
  setlist        Setlist       @relation(fields: [setlistId], references: [id])
  setlistCreator Musician?     @relation("GigSetlistCreator", fields: [setlistCreatorId], references: [id])
  expenses       Expense[]
  musicians      GigMusician[]

  @@index([bandId, date])
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Decimal
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  gigId String
  gig   Gig    @relation(fields: [gigId], references: [id])
}

model GigMusician {
  id         String    @id @default(cuid())
  musicianId String
  amountPaid Decimal?
  paidAt     DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())

  gigId    String
  gig      Gig      @relation(fields: [gigId], references: [id])
  musician Musician @relation(fields: [musicianId], references: [id])

  @@unique([gigId, musicianId])
}
